# ============================================================
# Fire Intelligence Platform — variáveis de ambiente
# Copie para .env (local) e configure por ambiente na Vercel:
#   Development / Preview / Production (docs/SETUP.md, docs/VERCEL.md)
# ============================================================

# --- Banco de dados (Neon via integração da Vercel, ou manual) ---
# INTEGRAÇÃO VERCEL × NEON (padrão recomendado): ao criar o banco aba Database →
# Neon, a Vercel injeta AUTOMATICAMENTE no deploy:
#   DATABASE_URL            (pooled — usada pela API)          ← nada a fazer
#   DATABASE_URL_UNPOOLED   (direta — usada por migrations/pipeline) ← nada a fazer
# O fallback para essas duas já está implementado no código
# (backend/app/core/config.py e pipeline/config.py). NÃO edite código depois.
#
# Setup MANUAL (alternativa), preencha as duas:
# Conexão POOLED: usada pela API nas Vercel Functions (runtime).
DATABASE_URL=
# Conexão DIRETA: usada por Alembic/migrations e pelo pipeline (fora da Vercel).
DATABASE_URL_DIRECT=

# --- NASA FIRMS (somente servidor/pipeline; JAMAIS no Git ou frontend) ---
# Chave gratuita da conta Earthdata: https://firms.modaps.eosdis.nasa.gov/api/map_key/
MAP_KEY=
# Fontes que o pipeline ingere (separadas por vírgula)
FIRMS_SOURCES=MODIS_SP,MODIS_NRT,VIIRS_SNPP_SP,VIIRS_SNPP_NRT,VIIRS_NOAA20_SP,VIIRS_NOAA20_NRT,VIIRS_NOAA21_SP,VIIRS_NOAA21_NRT

# --- Administração ---
# Habilita POST /api/admin/migrate (rodar migrations SEM sair da Vercel).
# Recomendação: habilitar (true) para aplicar migrations; pode desligar depois.
ADMIN_ENABLED=false
# Protege endpoints POST /api/admin/* — gere um valor forte no deploy
ADMIN_TOKEN=
# Protege tarefas leves do Vercel Cron
CRON_SECRET=

# --- Frontend (públicas, prefixo VITE_ — sem segredos aqui) ---
# Em dev local o SPA usa o proxy do Vite para /api (ver frontend/vite.config.ts).
VITE_API_BASE_URL=
# Token público do Cesium ion (mapa 3D realista), restrito por domínio na conta do Cesium.
VITE_CESIUM_ION_TOKEN=

# --- Pipeline local ---
DATA_DIR=data
